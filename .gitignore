dist/

# Python bytecode caches
__pycache__/
*.pyc

# Lab evidence / captures (not shipped)
captures/
releases/
remote_out/

# Versioned release payloads are intentionally tracked so release packages are
# reproducible from a fresh clone and cannot pick up stale local bitstreams.
!release_artifacts/
!release_artifacts/**

# Permanent lab memory / rescued /tmp evidence (never shipped, may contain lab data)
# The lab record lives in the private monorepo ~/Projects/lab-monorepo.
# "Memory" is a SYMLINK to projects/misterplex/memory there, so both forms are
# needed: "Memory/" alone matches only a real directory and would let the
# symlink itself get committed.
Memory
Memory/

# Agent scratch/build logs: never belongs in the repo (parent swept 7398 lines
# into a mislabeled commit via `git add -A`, 2026-08-04). Both forms: dir and symlink.
.agent-work
.agent-work/

# Lab HDMI capture output (multi-GB .mkv). Lives as a real dir in the primary
# checkout and as a symlink in worktrees; ignore both forms so `git add -A`
# cannot sweep it (same trap class as .agent-work).
avsync_hdmi_out
avsync_hdmi_out/

# --- Lab / agent scratch that lives in the primary checkout ---------------
# These accumulate in the working tree during long orchestration runs. None of
# them are source. They are listed explicitly so that a `git add -A` by any lane
# cannot sweep them into a commit (see 0b7851ed for the incident this prevents).
.copilot-session/
.copilot-w-*/
.scratch-archive/
.scratch-w-*/
.session-w-*.txt
.cpu_a_*
.worktrees/
MisterPlex-wt-*/
artifacts/
node_modules/
# Editor / agent backup copies of source files
*.bak-*
# Agent status files belong in Memory/, never at the repo root
misterplex-agent-*.txt
# Numbered HDMI capture frame dumps (v1/f_001.png ...)
/v[0-9]/
