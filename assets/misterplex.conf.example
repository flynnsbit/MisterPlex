# MiSTerPlex on-device conf → /media/fat/misterplex/misterplex.conf
# Restart after edits: killall misterplexd; re-run deploy or startup hook.

# --- PMS (multi-server) ---
# Default / fallback base (first in list). Cast playMedia address= still wins when present.
PLEX_BASE=http://192.168.1.41:32400
# Optional: comma-separated additional servers (or use multiple PLEX_BASE= lines).
# PLEX_SERVERS=http://192.168.1.41:32400,http://192.168.1.50:32400
# PLEX_BASE=http://192.168.1.50:32400
PLEX_HOST=192.168.1.41
# Optional static token (cast often supplies transient X-Plex-Token)
# PLEX_TOKEN=

# --- Decode / present (Phase 2 transitional ARM path) ---
FFMPEG=/media/fat/mistercast/bin/ffmpeg
DECODE=320x240
# WEAK_RES=320x240
# WEAK_BITRATE=1000
# PRESENT=fb0|fpga|both
PRESENT=fb0
# STREAM=1  # annex-B → host I-recon F1 + F3 (Phase 3.3i product path)
# Prefer direct H.264 Part when STREAM=1 (avoids High/CABAC universal for recon).
# High/CABAC: sticky skip from PPS entropy flag (no residual walk per IDR).
# STREAM_SKIP_RGB=auto  # skip heavy RGB only when PRESENT=fpga (audio + recon from start)
# STREAM_SKIP_RGB=0     # always FFmpeg RGB (CABAC fallback / PRESENT=both keeps RGB anyway)
# PRESENT=both always keeps FFmpeg RGB for continuous fb0 regardless of STREAM_SKIP_RGB.

# --- Phase 4 UX ---
# AUTO_NEXT=1  # on media EOF, play next playQueue item when bound (default on)
# AUTO_NEXT=0
# Subtitles: off | burn (PMS universal) | ffmpeg (local files, STREAM=0 only)
# See docs/subtitles-burnin.md
SUBTITLES=off
# SUBTITLE_STREAM=0

# --- Match source Hz / Content FPS (Phase 4) ---
# Plex.rbf does NOT yet implement Groovy-style CmdSwitchres modeline swaps.
# On each play, misterplexd reads PMS videoFrameRate/frameRate and logs a Content
# FPS hint (12/24/30/60). Set OSD **Content FPS** to match for 3:2 / 2:2 cadence.
# SOURCE_FPS=auto → use PMS metadata; 24|30|60|12 forces; off disables hint.
# MATCH_SOURCE_HZ=on logs target Hz but still uses cadence (switchres TODO).
# See docs/match-source-hz.md.
MATCH_SOURCE_HZ=off
SOURCE_FPS=auto

# --- A/V lipsync (post vsync present) ---
# FFmpeg adelay (ms) on the product dual-pipe path. Default 0 = no intentional lag.
# Positive delays audio content vs video (voice-ahead / lips-late → try 20–60 eyes-on).
# Measure: cast Sync Trekmatch blip (PMS 9/10); eyes-on Trek S1E1 @ ~3:54 after seek.
# Baseline HDMI flash↔beep @ 0: median ~−54…−60 ms (audio early). See MILESTONE_AVSYNC_SEEK.md.
# AUDIO_DELAY_MS=0
