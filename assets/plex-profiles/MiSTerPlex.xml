<?xml version="1.0" encoding="utf-8"?>
<Client name="MiSTerPlex">
  <!-- MiSTerPlex path profile (480p shipping + 720p aggressive path tier).
       See docs/pms-baseline-profile.md and .agent-work/w-path/REPORT.md.
       720p encode uses level 3.1 (MaxFS); 480p still fits under 3.1. -->
  <TranscodeTargets>
    <VideoProfile protocol="http" container="mpegts" codec="h264" audioCodec="aac" context="streaming">
      <!-- Force x264 into the narrow subset the FPGA/host decoder is scoped for:
           Baseline/CAVLC, no B-slices, one reference, no weighted P prediction,
           no 8x8 DCT, and no sub-macroblock inter partitions.
           Level 3.1 required for 1280x720 path tier (lab: decision said baseline
           but unbounded encode produced Main when profile caps blocked 720). -->
      <Setting name="VideoEncodeFlags" value="-profile:v baseline -level 3.1 -x264opts cabac=0:bframes=0:ref=1:weightp=0:8x8dct=0:partitions=none:keyint=50:min-keyint=25:scenecut=0" />
      <Setting name="SubtitleSize" value="100" />
    </VideoProfile>
    <MusicProfile container="mp3" codec="mp3" />
    <PhotoProfile container="jpeg" />
  </TranscodeTargets>

  <!-- Intentionally no broad DirectPlayProfiles: MiSTerPlex should use the
       constrained transcode target unless/until the hardware decoder supports
       the source codec/profile directly. -->

  <CodecProfiles>
    <VideoCodec name="*">
      <Limitations>
        <UpperBound name="video.width" value="1280" isRequired="true" />
        <UpperBound name="video.height" value="720" isRequired="true" />
        <UpperBound name="video.frameRate" value="30" isRequired="true" />
        <UpperBound name="video.bitDepth" value="8" isRequired="true" />
      </Limitations>
    </VideoCodec>
    <VideoCodec name="h264">
      <Limitations>
        <Match name="video.profile" list="baseline" isRequired="true" />
        <UpperBound name="video.level" value="31" isRequired="true" />
        <UpperBound name="video.refFrames" value="1" isRequired="true" />
      </Limitations>
    </VideoCodec>
    <VideoAudioCodec name="aac">
      <Limitations>
        <UpperBound name="audio.channels" value="2" isRequired="true" />
      </Limitations>
    </VideoAudioCodec>
  </CodecProfiles>

  <TranscodeTargetProfiles>
    <VideoTranscodeTarget protocol="http" context="streaming">
      <VideoCodec name="h264">
        <Limitations>
          <Match name="video.profile" list="baseline" onlyTranscodes="true" isRequired="true" />
          <UpperBound name="video.level" value="31" onlyTranscodes="true" isRequired="true" />
          <UpperBound name="video.refFrames" value="1" onlyTranscodes="true" isRequired="true" />
        </Limitations>
      </VideoCodec>
      <VideoAudioCodec name="aac">
        <Limitations>
          <UpperBound name="audio.channels" value="2" onlyTranscodes="true" isRequired="true" />
        </Limitations>
      </VideoAudioCodec>
    </VideoTranscodeTarget>
  </TranscodeTargetProfiles>
</Client>
