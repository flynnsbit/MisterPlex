# Sealed 480i host-paint product (e36 free-run ALSA + lipsync av_lock)
CONTENT_RES=480i
DISPLAY_RES=480i
DECODE=720x480
WEAK_RES=720x480
WEAK_BITRATE=8000
WEAK_H264_PROFILE=baseline
WEAK_QUALITY=40
FPGA_OWNS_FS=1
MPX_VIDEO_BACKEND=legacy-software
MPX_H264_PROTOTYPE=idr
MPX_H264_FILTER=off
PRESENT=fpga
AUDIO=on
OSD_CONTROL=0
TRANSCODE_PROFILE=480i
STREAM=0
SUBTITLES=off
AUTO_NEXT=0
SOURCE_FPS=auto
AV_CONTENT_FPS=auto
MATCH_SOURCE_HZ=off
MPX_LEGACY_CORE_PREFIX=56f38fff
MPX_PRESENT_480I=1
MPX_PRESENT_480P=0
MPX_STICK_I420=0
MPX_FABRIC_DIRECT=0
AV_PRESENT_LEAD_MS=40
AV_RESYNC_DROP_MS=0
AV_OFFSET_MS=0
AUDIO_DELAY_MS=100
FFMPEG_SWS_FLAGS=lanczos
FFMPEG_FPS_FILTER=off
DEINTERLACE=off
IDLE_SCREEN=logo
