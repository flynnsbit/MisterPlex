# BW contract .svh are MODULE-LOCAL includes only (no global `ifndef).
# Do NOT compile them as standalone SYSTEMVERILOG_FILE — multi-consumer
# localparams must expand inside each module that `include`s them.
set_global_assignment -name SDC_FILE Plex.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Plex.sv
