# Dedicated clk_pix PLL instance assignments (TCL: '#' comments only — never '//')
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll_pix_0002*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_AUTO_RESET ON -to "*pll_pix_0002*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pll_pix_0002*|altera_pll:altera_pll_i*|*"
