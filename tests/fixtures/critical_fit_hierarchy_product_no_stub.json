{
  "schema": "misterplex.critical_fit_hierarchy.v1",
  "modules": [
    {
      "name": "ddr_frame_store",
      "entity": "ddr_frame_store",
      "hierarchy_contains": "ddr_frame_store:fstore",
      "log_contains": "present|fstore",
      "min_comb_aluts": 1000,
      "min_registers": 500,
      "min_block_memory_bits": 100000,
      "min_m10ks": 1
    },
    {
      "name": "present_core",
      "entity": "present_core",
      "hierarchy_contains": "present_core:present",
      "min_comb_aluts": 10,
      "min_registers": 10
    },
    {
      "name": "stream_path",
      "entity": "stream_path",
      "hierarchy_contains": "stream_path:spath",
      "min_comb_aluts": 1000,
      "min_registers": 500
    },
    {
      "name": "ddr_bitstream_reader",
      "entity": "ddr_bitstream_reader",
      "hierarchy_contains": "ddr_bitstream_reader:ddr_stream",
      "min_comb_aluts": 100,
      "min_registers": 100
    },
    {
      "name": "plex_rbf_build_id",
      "entity": "plex_rbf_build_id",
      "hierarchy_contains": "plex_rbf_build_id:u_rbf_build_id",
      "min_comb_aluts": 0,
      "min_registers": 8,
      "notes": "Fabric git stamp \u2014 must survive fitting with non-trivial registers (post-fit stage; requires FIT_RPT)."
    },
    {
      "name": "decode_stub",
      "entity": "decode_stub",
      "hierarchy_contains": "decode_stub",
      "must_be_absent": true,
      "max_total_resources": 0,
      "notes": "PRODUCT_NO_STUB reclaim \u2014 fitted hierarchy must show 0 resources for decode_stub"
    }
  ]
}
