# Copy to .env.lab or ~/.config/misterplex/e2e.env (gitignored).
# Do not commit real tokens or private PMS URLs into the repo.
PLEX_BASE=http://YOUR-PLEX-SERVER:32400
MISTER_HOST=192.168.1.183
MISTER_PORT=3005
PLEX_TOKEN_FILE=/tmp/local_tok.txt
# Optional pin — leave unset to auto-pick first Home profile (logged as PLEX_WEB_USER_DEFAULTED=)
# PLEX_WEB_USER=YourProfileName
E2E_TIER=240p
E2E_TRANSITION_CYCLES=10
E2E_PLXD_FRAMES_VOID=1
E2E_REQUIRE_PID=1
E2E_OUTPUT_W=1920
E2E_OUTPUT_H=1080
# Overlay grab (parent HDMI): E2E_OVERLAY_ONLY=1 E2E_OVERLAY_HOLD_SEC=10
